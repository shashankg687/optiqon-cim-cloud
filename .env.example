# ==============================================================================
# Quantum Ising Optimizer Cloud Platform - Environment Configuration
# ==============================================================================

# Hardware Target
CIM_HARDWARE_URL="http://192.168.1.230:5050/run_ising"
CIM_TIMEOUT_SECONDS=8.0

# Database Configuration (Leave blank for local SQLite, or enter Supabase PostgreSQL)
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Security & JWT Tokens
JWT_SECRET="replace-with-a-secure-random-64-character-string"
JWT_EXPIRATION_HOURS=168

# Quotas & Credits
DEFAULT_SIGNUP_CREDITS=100

# Server Binding
SERVER_HOST="0.0.0.0"
SERVER_PORT=8000
